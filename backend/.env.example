# EcoVision AI backend configuration (copy to .env for local use; set these in the Render dashboard in production)
# Do NOT put secrets here. This service needs none.

# Comma-separated list of exact frontend origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://YOUR-APP.vercel.app
# Optional regex for Vercel preview deployments
# CORS_ORIGIN_REGEX=https://ecovision-ai-.*\.vercel\.app

# Paths are relative to the backend/ folder
MODEL_PATH=models/mobilenetv2_waste.keras
UNCERTAINTY_THRESHOLD=0.55
MAX_IMAGE_SIZE_MB=10

# Optional: download the model at startup if the file is not in the repo (https only)
# MODEL_URL=https://github.com/YOU/ecovision-ai/releases/download/v1/mobilenetv2_waste.keras
# MODEL_SHA256=
