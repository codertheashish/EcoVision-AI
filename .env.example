# Frontend environment variables (copy to .env.local for local dev; set in the Vercel dashboard for production).
# Only VITE_* variables are exposed to the browser. NEVER put secrets here.

# Local development: http://127.0.0.1:8000
# Production: your Render backend URL (placeholder below, replace with the real one)
VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
